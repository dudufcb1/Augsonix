# Copy to .env and fill in. Only secrets belong here — a provider's base_url and
# model are configured in reasonix.toml, where api_key_env points at these variables.

DEEPSEEK_API_KEY=
MIMO_API_KEY=

# Búsqueda semántica del código (sección [codesearch]). Sin la primera, la
# herramienta no se registra y no cuesta nada en el prompt.
VOYAGE_API_KEY=
# Solo con backend = "postgres". Formato:
# postgres://usuario:clave@host:5432/base?sslmode=disable
CODESEARCH_POSTGRES_URL=
